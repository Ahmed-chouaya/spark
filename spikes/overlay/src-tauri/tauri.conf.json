{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "overlay-spike",
  "version": "0.1.0",
  "identifier": "dev.spark.overlay.spike",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "label": "mascot",
        "title": "overlay spike",
        "width": 140,
        "height": 150,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icon.png"
    ]
  }
}
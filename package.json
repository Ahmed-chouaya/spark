{
  "name": "spark",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Spark mascot \u2014 state vector library",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "extract:anchors": "node scripts/extract-anchors.mjs",
    "probe:capability": "node scripts/probe-capability.mjs",
    "relay:build": "cargo build --release --manifest-path relay/Cargo.toml",
    "relay:install": "node scripts/relay-install.ts",
    "relay:uninstall": "node scripts/relay-install.ts uninstall",
    "companion": "vite-node scripts/spark-companion.ts",
    "shell:build": "vite build --config shell/vite.config.ts",
    "shell:run": "cargo run --manifest-path shell/src-tauri/Cargo.toml",
    "relay:verify": "vite-node scripts/relay-integration.ts",
    "verify": "npm run extract:anchors && npm run typecheck && npm run test",
    "test:e2e": "e2e run",
    "decision:verify": "vite-node scripts/decision-integration.ts"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.0",
    "@ai-sdk/google": "^4.0.0",
    "@ai-sdk/openai": "^4.0.0",
    "@ai-sdk/openai-compatible": "^3.0.0",
    "@e2e-dev/web": "^0.14.0",
    "@tauri-apps/api": "^2.12.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "ai": "^7.0.0",
    "e2e": "^0.19.0",
    "jsdom": "^25.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.8",
    "zod": "^4.1.8"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}

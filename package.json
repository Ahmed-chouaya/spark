    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "ai": "^7.0.0",
    "e2e": "^0.19.0",
    "jsdom": "^25.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
